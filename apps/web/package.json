{
  "name": "@vybe/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "desktop:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron . --dev\"",
    "desktop:run": "vite build && electron .",
    "desktop:exe": "vite build && electron-builder --win --x64",
    "desktop": "electron .",
    "electron:dev": "npm run desktop:dev",
    "electron:build": "npm run desktop:exe",
    "android:init": "npm install @capacitor/core @capacitor/cli @capacitor/android && npx cap add android",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@distube/ytdl-core": "^5.1.3",
    "@supabase/supabase-js": "^2.118.0",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.468.0",
    "play-dl": "^1.9.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yt-search": "^2.13.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.6",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^9.5.1"
  }
}
