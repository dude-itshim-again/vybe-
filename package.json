{
  "name": "vybe-monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "desktop": "npm --prefix apps/web run desktop",
    "electron:dev": "npm --prefix apps/web run electron:dev",
    "electron:build": "npm --prefix apps/web run electron:build"
  }
}
